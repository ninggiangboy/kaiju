# Bí mật thật không bao giờ vào repository — chỉ tệp mẫu trong infra/env/.
infra/env/*.env
!infra/env/*.env.example
.env
.env.local

.DS_Store

# Ansible inventory names real machines.
infra/ansible/inventory/hosts.yml

# OpenTofu state contains secrets in readable form, and local variable files.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars

# Worktrees live under .claude/ but are checkouts, not project files.
.claude/worktrees/

# Bậc 4 — production.  Ở bậc này các giá trị KHÔNG nằm trong tệp: chúng là một
# Secret của nền tảng điều phối, tên `kaiju-secrets`. Tệp này chỉ là danh sách
# khoá bắt buộc, để thiếu một khoá thì phát hiện được trước khi triển khai.
#
# Migration KHÔNG chạy lúc khởi động ở bậc này (CON-68) — nó là một công việc
# riêng chạy trước, xem infra/k8s/base/migrate-job.yaml.

# Thẻ ảnh do pipeline ghi vào bản kê khai, không qua tệp này (CON-70).

# Dịch vụ cơ sở dữ liệu quản lý sẵn.
KAIJU_DB_URL=jdbc:postgresql://REPLACE:5432/kaiju
# CON-25: phải trỏ THẲNG tới cơ sở dữ liệu. Nếu về sau thêm bộ gộp kết nối ở
# bậc này, biến trên đổi còn biến dưới thì KHÔNG.
KAIJU_DB_LISTEN_URL=jdbc:postgresql://REPLACE:5432/kaiju
KAIJU_DB_USER=kaiju
KAIJU_DB_PASSWORD=REPLACE

KAIJU_REDIS_URL=rediss://REPLACE:6379

# Dịch vụ gửi thư giao dịch THẬT. Đây là thành phần trọng yếu ngang cơ sở dữ
# liệu: magic link là cách đăng nhập duy nhất, nên thư chết = không ai vào được.
# Xác thực tên miền gửi phải cấu hình đầy đủ, nếu không thư vào hộp thư rác và
# triệu chứng người dùng thấy là "đăng nhập không hoạt động".
KAIJU_MAIL_TRANSPORT=smtp
KAIJU_MAIL_HOST=REPLACE
KAIJU_MAIL_PORT=587
KAIJU_MAIL_USER=REPLACE
KAIJU_MAIL_PASSWORD=REPLACE
KAIJU_MAIL_FROM=no-reply@kaiju.example.com

# Dịch vụ tương thích S3 THẬT.
KAIJU_OBJECT_STORAGE_ENDPOINT=https://REPLACE
KAIJU_OBJECT_STORAGE_REGION=REPLACE
KAIJU_OBJECT_STORAGE_BUCKET=kaiju-attachments
KAIJU_OBJECT_STORAGE_ACCESS_KEY=REPLACE
KAIJU_OBJECT_STORAGE_SECRET_KEY=REPLACE
KAIJU_OBJECT_STORAGE_PATH_STYLE=false

KAIJU_PUBLIC_URL=https://kaiju.example.com
KAIJU_TOKEN_SIGNING_KEY=REPLACE

# Đích thu thập THẬT, không phải container gói sẵn — nhà phát hành của container
# đó nói rõ nó không dành cho môi trường thật.
OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

KAIJU_MIGRATE_ON_STARTUP=false
KAIJU_SEED_DATA=false

# Tier 4 - production.  At this tier the values are NOT in a file: they are an
# orchestrator Secret named `kaiju-secrets`. This file is only the list of
# required keys, so a missing one is caught before deploying.
#
# Migrations do NOT run at startup here (CON-68) - they are a separate job that
# runs first; see infra/k8s/base/migrate-job.yaml.

# Image tags are written into the manifests by the pipeline, not through this
# file (CON-70).

# A managed database service.
KAIJU_DB_URL=jdbc:postgresql://REPLACE:5432/kaiju
# CON-25: must point DIRECTLY at the database. If a connection pooler is ever
# added at this tier, the variable above changes and this one does NOT.
KAIJU_DB_LISTEN_URL=jdbc:postgresql://REPLACE:5432/kaiju
KAIJU_DB_USER=kaiju
KAIJU_DB_PASSWORD=REPLACE

KAIJU_REDIS_URL=rediss://REPLACE:6379

# A REAL transactional mail service. This component is as critical as the
# database: magic link is the only way to sign in, so mail down means nobody
# gets in. Sender domain authentication must be fully configured, otherwise
# mail lands in spam and the symptom users report is "signing in does not work".
KAIJU_MAIL_TRANSPORT=smtp
KAIJU_MAIL_HOST=REPLACE
KAIJU_MAIL_PORT=587
KAIJU_MAIL_USER=REPLACE
KAIJU_MAIL_PASSWORD=REPLACE
KAIJU_MAIL_FROM=no-reply@kaiju.example.com

# A REAL S3-compatible service.
KAIJU_OBJECT_STORAGE_ENDPOINT=https://REPLACE
KAIJU_OBJECT_STORAGE_REGION=REPLACE
KAIJU_OBJECT_STORAGE_BUCKET=kaiju-attachments
KAIJU_OBJECT_STORAGE_ACCESS_KEY=REPLACE
KAIJU_OBJECT_STORAGE_SECRET_KEY=REPLACE
KAIJU_OBJECT_STORAGE_PATH_STYLE=false

KAIJU_PUBLIC_URL=https://kaiju.example.com
KAIJU_TOKEN_SIGNING_KEY=REPLACE

OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

KAIJU_MIGRATE_ON_STARTUP=false
KAIJU_SEED_DATA=false

# Tier 3 - staging.  The real file lives at /etc/kaiju/staging.env ON THE HOST,
# mode 600, and NOT in the repository.
#
# What separates this from tiers 1-2 is not "more variables" but that every
# service is real (CON-73). No mail catcher, no self-hosted object storage, no
# bundled observability container.

# An immutable tag bound to a commit (CON-70). NEVER `latest`.
KAIJU_IMAGE=ghcr.io/OWNER/kaiju-backend:sha-REPLACE
KAIJU_FRONTEND_IMAGE=ghcr.io/OWNER/kaiju-frontend:sha-REPLACE
KAIJU_DOMAIN=staging.kaiju.example.com

# PostgreSQL installed on the host, not in a container - I/O performance and
# data durability. Use host.docker.internal or the Docker bridge address.
KAIJU_DB_URL=jdbc:postgresql://host.docker.internal:5432/kaiju
KAIJU_DB_LISTEN_URL=jdbc:postgresql://host.docker.internal:5432/kaiju
KAIJU_DB_USER=kaiju
KAIJU_DB_PASSWORD=REPLACE

KAIJU_REDIS_URL=redis://host.docker.internal:6379

# A REAL transactional mail service. This component is as critical as the
# database: magic link is the only way to sign in, so mail down means nobody
# gets in. Sender domain authentication must be fully configured, otherwise
# mail lands in spam and the symptom users report is "signing in does not work".
KAIJU_MAIL_TRANSPORT=smtp
KAIJU_MAIL_HOST=REPLACE
KAIJU_MAIL_PORT=587
KAIJU_MAIL_USER=REPLACE
KAIJU_MAIL_PASSWORD=REPLACE
KAIJU_MAIL_FROM=no-reply@staging.kaiju.example.com

# A REAL S3-compatible service.
KAIJU_OBJECT_STORAGE_ENDPOINT=https://REPLACE
KAIJU_OBJECT_STORAGE_REGION=REPLACE
KAIJU_OBJECT_STORAGE_BUCKET=kaiju-staging-attachments
KAIJU_OBJECT_STORAGE_ACCESS_KEY=REPLACE
KAIJU_OBJECT_STORAGE_SECRET_KEY=REPLACE
KAIJU_OBJECT_STORAGE_PATH_STYLE=false

KAIJU_PUBLIC_URL=https://staging.kaiju.example.com
KAIJU_TOKEN_SIGNING_KEY=REPLACE

# A REAL collection endpoint, not the bundled container - its publisher states
# plainly that it is not meant for production.
OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=staging

KAIJU_MIGRATE_ON_STARTUP=false
KAIJU_SEED_DATA=false

# Bậc 2 — dev.  Chỉ cần khi chạy backend NGOÀI Docker nhưng vẫn muốn đi qua bộ
# gộp kết nối và hệ thống quan sát của bậc 2. Bốn vai trò chạy trong container
# lấy cấu hình từ chính tệp compose, không từ đây.

KAIJU_ROLE=api

# Đường ghi/đọc thường đi QUA bộ gộp kết nối (cổng 6432)...
KAIJU_DB_URL=jdbc:postgresql://localhost:6432/kaiju
# ...còn kết nối lắng nghe thông báo đi THẲNG (cổng 5432). Ở chế độ gộp theo
# giao dịch, cơ chế lắng nghe không bao giờ hoạt động qua bộ gộp (CON-25).
KAIJU_DB_LISTEN_URL=jdbc:postgresql://localhost:5432/kaiju
KAIJU_DB_USER=kaiju
KAIJU_DB_PASSWORD=kaiju
KAIJU_DB_POOL_SIZE=10

KAIJU_REDIS_URL=redis://localhost:6379

KAIJU_MAIL_TRANSPORT=smtp
KAIJU_MAIL_HOST=localhost
KAIJU_MAIL_PORT=1025
KAIJU_MAIL_FROM=no-reply@kaiju.localhost

KAIJU_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
KAIJU_OBJECT_STORAGE_BUCKET=kaiju-attachments
KAIJU_OBJECT_STORAGE_ACCESS_KEY=kaiju
KAIJU_OBJECT_STORAGE_SECRET_KEY=kaiju-dev-secret
KAIJU_OBJECT_STORAGE_PATH_STYLE=true

KAIJU_PUBLIC_URL=http://localhost:3000
KAIJU_TOKEN_SIGNING_KEY=dev-only-not-a-real-key-change-everywhere-else

KAIJU_MIGRATE_ON_STARTUP=true
KAIJU_SEED_DATA=true

# Chuẩn mở, không tên sản phẩm nào (CON-64).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=always_on
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

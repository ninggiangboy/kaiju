# Tier 2 - dev.  Only needed when running the backend OUTSIDE Docker while still
# going through the tier 2 connection pooler and observability stack. The four
# roles running in containers get their configuration from the compose file, not
# from here.

KAIJU_ROLE=api

# Ordinary reads and writes go THROUGH the connection pooler (port 6432)...
KAIJU_DB_URL=jdbc:postgresql://localhost:6432/kaiju
# ...while the notification listener connects DIRECTLY (port 5432). Under
# transaction pooling, listening never works through a pooler (CON-25).
KAIJU_DB_DIRECT_URL=jdbc:postgresql://localhost:5432/kaiju
KAIJU_DB_USER=kaiju
KAIJU_DB_PASSWORD=kaiju
KAIJU_DB_POOL_SIZE=10

KAIJU_REDIS_URL=redis://localhost:6379

KAIJU_MAIL_TRANSPORT=smtp
KAIJU_MAIL_HOST=localhost
KAIJU_MAIL_PORT=1025
KAIJU_MAIL_FROM=no-reply@kaiju.localhost

KAIJU_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
KAIJU_OBJECT_STORAGE_BUCKET=kaiju-attachments
KAIJU_OBJECT_STORAGE_ACCESS_KEY=kaiju
KAIJU_OBJECT_STORAGE_SECRET_KEY=kaiju-dev-secret
KAIJU_OBJECT_STORAGE_PATH_STYLE=true

KAIJU_PUBLIC_URL=http://localhost:3000
KAIJU_TOKEN_SIGNING_KEY=dev-only-not-a-real-key-change-everywhere-else

# Migrations never run at application startup, at any tier (CON-68). The
# migration runner reads these; `make db-up`, `db-down` and `db-status` set
# KAIJU_MIGRATE_COMMAND for you.
KAIJU_MIGRATE_COMMAND=up
KAIJU_MIGRATE_COUNT=1
KAIJU_SEED_DATA=true

# Open standard, no product name (CON-64).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=always_on
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

# Tier 2 - the reverse proxy in development, no TLS.
#
# This file exists for ONE line: `flush_interval -1` in the sync stream block.
# Without it, deltas sit in a buffer until it fills, the symptom is "realtime
# does not work", and there is NO error anywhere.

{
	admin off
	auto_https off
}

:8080 {
	log {
		format console
	}

	# --- Sync stream -----------------------------------------------------
	# Must come BEFORE the catch-all block below.
	handle /api/sync/stream* {
		reverse_proxy realtime:8080 {
			# Buffering off. This is why the whole file exists.
			flush_interval -1
			# The read timeout must be longer than the heartbeat interval, or
			# connections are closed constantly and clients re-bootstrap for
			# nothing.
			transport http {
				read_timeout 0
			}
			header_up X-Accel-Buffering no
		}
	}

	# --- The rest of the API ---------------------------------------------
	handle /api/* {
		reverse_proxy api:8080
	}

	# --- Per-role health checks ------------------------------------------
	handle /internal/health/realtime {
		reverse_proxy realtime:8080 {
			rewrite /actuator/health
		}
	}

	handle /internal/health/api {
		reverse_proxy api:8080 {
			rewrite /actuator/health
		}
	}

	# Upload size limit; without it large files are rejected with a confusing
	# message.
	request_body {
		max_size 50MB
	}

	handle {
		respond "kaiju dev proxy" 200
	}
}

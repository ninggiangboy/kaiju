# Tier 3 - real TLS, real domain. Caddy obtains and renews the certificate.
#
# Identical to Caddyfile.dev where it matters most: the sync stream must not be
# buffered. What differs is that here it travels over real TLS for the first
# time.

{$KAIJU_DOMAIN} {
	log {
		format json
	}

	encode zstd gzip

	handle /api/sync/stream* {
		reverse_proxy realtime:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
			header_up X-Accel-Buffering no
		}
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	request_body {
		max_size 50MB
	}

	# Marketing pages and the magic-link landing page - the only part rendered
	# on the server (ADR-0008).
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
